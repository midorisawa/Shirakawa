{
  "manifest_version": 3,
  "name": "Shirakawa",
  "version": "0.1.2",
  "description": "JevでX投稿を判定し、条件に合う投稿を非表示にする",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://api.typesafe.ai/*", "https://openrouter.ai/api/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Shirakawa設定",
    "default_popup": "options/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/index.html",
  "content_scripts": [{ "matches": ["https://x.com/*"], "js": ["content.js"], "run_at": "document_start" }]
}
